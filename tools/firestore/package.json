{
  "name": "agam-firestore-tools",
  "private": true,
  "description": "Seed koleksi pois/facilities dari assets/data/pois.json dan test security rules AGAM",
  "type": "module",
  "scripts": {
    "seed": "node seed_pois.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-agam \"node --test rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "14.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  }
}
