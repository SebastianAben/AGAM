<!-- Ikon tombol kontrol narasi (PB08) dicari audio_service lewat nama, jadi
     resource shrinker build release menganggapnya tidak terpakai dan
     membuangnya. Tanpa ikon ini notifikasi media tidak muncul.
     ic_stat_agam (ikon status bar notifikasi sesi lokasi, trigger, dan
     narasi) juga hanya dirujuk lewat nama dari Dart. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_stat_agam" />
